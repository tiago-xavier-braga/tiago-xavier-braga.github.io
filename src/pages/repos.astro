---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import RepoCard from '../components/RepoCard.astro';
import Icon from '../components/Icon.astro';

const repos = (await getCollection('repos')).sort((a, b) => a.data.order - b.data.order);
const count = `${repos.length} ${repos.length === 1 ? 'repository' : 'repositories'}`;
---

<Base title="Open source" description="Tools and libraries for Godot and Unity, built in the open." current="open-source">
  <section class="container header">
    <p class="overline">Open source</p>
    <h1 class="display">Code I <em class="hl">share</em>.</h1>
    <p class="lead">Tools and libraries for Godot and Unity, built in the open.</p>
  </section>

  <section class="container list" aria-label="Repositories">
    <div class="toolbar">
      <p class="body-sm muted">{count}</p>
      <a class="arrow-link" href="https://github.com/tiago-xavier-braga">GitHub <Icon name="arrow-right" /></a>
    </div>
    <div class="grid">
      {repos.map((repo) => <RepoCard repo={repo} showTopics />)}
    </div>
  </section>
</Base>

<style>
  .header {
    display: grid;
    gap: var(--space-24);
    padding-block: var(--space-96) var(--space-48);
  }

  .list {
    padding-bottom: var(--space-96);
  }

  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-32);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-24);
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 760px) {
    .header {
      padding-block: var(--space-48) var(--space-32);
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .list {
      padding-bottom: var(--space-64);
    }
  }
</style>
