---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found">
  <section class="container stage">
    <div class="card">
      <Icon name="bird" size={96} strokeWidth={0.75} />
      <p class="overline">Error 404</p>
      <h1 class="h1">This page <em class="hl">flew</em> away.</h1>
      <p class="muted">The page you're looking for doesn't exist or has moved.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/">Go home</a>
        <a class="btn btn-ghost" href="/projects/">View projects</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .stage {
    display: grid;
    place-items: center;
    min-height: 70vh;
    padding-block: var(--space-48);
  }

  .card {
    display: grid;
    justify-items: center;
    gap: var(--space-24);
    width: min(100%, 640px);
    padding: var(--space-64);
    border-radius: var(--radius-xl);
    background: var(--color-surface-raised);
    text-align: center;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-16);
  }

  @media (max-width: 640px) {
    .card {
      padding: var(--space-48) var(--space-24);
    }
  }
</style>
