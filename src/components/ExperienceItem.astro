---
import type { CollectionEntry } from 'astro:content';

interface Props {
  job: CollectionEntry<'experience'>;
}

const { period, role, company, description } = Astro.props.job.data;
---

<li class="job reveal">
  <p class="body-sm muted">{period}</p>
  <div class="details">
    <h3 class="h2">{role}</h3>
    <p class="label">{company}</p>
    <p class="prose">{description}</p>
  </div>
</li>

<style>
  .job {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--space-48);
    padding-block: 36px;
    border-top: 1px solid var(--color-border);
  }

  .job:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .details {
    display: grid;
    gap: var(--space-8);
  }

  .label {
    margin-bottom: var(--space-4);
  }

  @media (max-width: 640px) {
    .job {
      grid-template-columns: 1fr;
      gap: 12px;
      padding-block: var(--space-32);
    }
  }
</style>
